
# ===============================
# Django Settings
# ===============================
DEBUG=True
SECRET_KEY=your_super_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# ===============================
# Database (PostgreSQL Example)
# ===============================
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ===============================
# JWT Settings
# ===============================
ACCESS_TOKEN_LIFETIME = 15  # in minutes
REFRESH_TOKEN_LIFETIME = 7  # in days

# ===============================
# Hubtel SMS Configuration
# ===============================
HUBTEL_SMS_ENDPOINT = "https://smsc.hubtel.com/v1/messages/send"
HUBTEL_CLIENT_ID = "your-clientid"
HUBTEL_CLIENT_SECRET = "your-clientsecret"
HUBTEL_SENDER_ID = "yoursenderID"

# ===============================
# Email Configuration
# ===============================

EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# ===============================
# Frontend URL (for links in email templates)
# ===============================
FRONTEND_URL = http://localhost:5173
